/// Enco plugin contract. Plugins interact with the host only through these imports.
package enco:plugin@0.15.0;

/// Canonical data exchanged between the host and plugins.
interface types {
    /// A JSON document encoded as UTF-8 text.
    type json = string;

    /// A UTC instant, shaped like `wasi:clocks/wall-clock.datetime`.
    record datetime {
        /// Seconds since the Unix epoch.
        seconds: u64,
        /// Nanoseconds past `seconds`.
        nanoseconds: u32,
    }

    /// How a message relates to messages it quotes.
    enum quote-kind {
        /// It answers the message, or the messages that message forwarded.
        reply,
        /// It passes the messages on from elsewhere.
        forward,
    }

    /// An operation failure.
    record failure {
        /// A stable classification, such as `timeout` or `provider.auth`.
        code: string,
        /// What went wrong, for the Agent and the owner to read.
        message: string,
        /// Whether the same request may succeed later.
        retryable: bool,
    }

    /// Identifies the speaker of a canonical model message.
    enum role { system, user, assistant, tool }

    /// A proposed tool invocation.
    record tool-call {
        /// The call ID the service assigned, or empty when it assigns none.
        id: string,
        /// The tool to call, by the name its `tool-spec` declares.
        name: string,
        /// The arguments as the model wrote them, as JSON text.
        arguments: string,
    }

    /// A tool settlement.
    record tool-result {
        /// The `id` of the `tool-call` this result answers.
        call-id: string,
        /// The result text the model reads.
        content: string,
        /// Whether the call failed.
        is-error: bool,
    }

    /// Opaque adapter fields: the whole message as the adapter that wrote it replays it.
    ///
    /// The message's other parts are derived from them, so a message has at most one, and its
    /// JSON text is no shorter than their text plus each tool call's name and arguments. The host
    /// replays them only to their originating plugin identity.
    record extension {
        /// The fields, as the adapter that wrote them expects them back.
        data: json,
    }

    /// Image encodings that every supported service accepts.
    enum image-format { png, jpeg, webp }

    /// An image in a message.
    record image {
        /// How `data` is encoded.
        format: image-format,
        /// The image bytes as stored, not base64.
        data: list<u8>,
    }

    /// Ordered text, images, tool interactions and opaque extensions within a message.
    variant part {
        /// Text the speaker wrote.
        text(string),
        /// A tool call the assistant proposes.
        tool-call(tool-call),
        /// The result of a tool call.
        tool-result(tool-result),
        /// Adapter fields kept for the plugin that wrote them.
        extension(extension),
        /// An image attached to the message.
        image(image),
    }

    /// A canonical message sent to or returned by the model.
    record message {
        /// Who speaks.
        role: role,
        /// The content, in order.
        parts: list<part>,
    }

    /// A tool disclosed to the model.
    ///
    /// `input-schema` describes the argument object in a subset of JSON Schema:
    /// - objects with `properties` and `required`, always with `additionalProperties: false`;
    /// - strings with `enum`, `minLength` and `maxLength`;
    /// - integers and numbers with `minimum` and `maximum`;
    /// - booleans;
    /// - arrays with `items`, `minItems` and `maxItems`;
    /// - `anyOf` with two or more schemas.
    ///
    /// Any schema below the root may carry a `description` and a `default` that fits it; the root
    /// is an object and carries neither. A declaration outside the subset fails to load. The host
    /// checks every call against the schema before the plugin sees it: an optional property given
    /// as null counts as not given, and an integer written with a zero fraction, such as 5.0,
    /// arrives as 5.
    record tool-spec {
        /// The name the model calls the tool by: ASCII letters, digits, underscores or hyphens,
        /// unique among the plugin's tools.
        name: string,
        /// What the tool does, for the model to read.
        description: string,
        /// The argument object, in the subset of JSON Schema stated above.
        input-schema: json,
        /// What a call may change; completion adapters ignore it, and the host uses it when
        /// dispatching.
        effect: effect,
    }

    /// Mutation semantics used to order calls and settle interrupted work.
    ///
    /// Consecutive read-only calls run together; other calls run one at a time. A call cut off by
    /// a crash fails as retryable when it is read-only, and settles as unknown otherwise.
    enum effect {
        /// Changes nothing beyond its result.
        read-only,
        /// Making the call again has the same effect as making it once.
        idempotent,
        /// Changes something that must not be changed again blindly.
        side-effect,
    }

    /// A known result, a known failure, or an external effect that cannot be confirmed.
    variant outcome {
        /// The call succeeded with this JSON result.
        ok(json),
        /// The call failed, and its effects are known.
        failed(failure),
        /// An external effect may have happened and cannot be confirmed; it is never retried
        /// automatically.
        unknown(failure),
    }

    /// Why part of a message is kept only as a description.
    variant unviewable-reason {
        /// It is not a file Enco can keep, such as a location or a poll.
        unsupported,
        /// It could not be retrieved, for this reason.
        unavailable(string),
    }

    /// Part of a message's content kept only as a description, such as a location or an
    /// attachment that could not be fetched.
    ///
    /// Facts about the message, such as who sent it, are not content: one that cannot be read is
    /// absent instead.
    record unviewable {
        /// A plain description such as report.pdf, voice message or location, not a protocol type
        /// name.
        what: string,
        /// Why it cannot be shown.
        reason: unviewable-reason,
    }

    /// Endpoint, model and adapter options supplied by the caller for this call.
    record settings {
        /// The service's base URL; request paths are appended to it.
        base-url: string,
        /// The model the service runs.
        model: string,
        /// Options the adapter merges into its request, as a JSON object.
        options: json,
    }

    /// Token counts reported by the service, including cache hits when available.
    record usage {
        /// Tokens the request used.
        input-tokens: u64,
        /// Tokens the reply used.
        output-tokens: u64,
        /// The part of `input-tokens` served from the service's cache, when it reports one.
        cached-input-tokens: option<u64>,
    }

    /// The service turned a request away as larger than the model accepts.
    record overflow {
        /// The request's input as the service counted it, when it says; above `accepted` when
        /// both are present.
        counted: option<u64>,
        /// The most input the service accepts for this request, when it says, after any output
        /// it counts against the same window.
        accepted: option<u64>,
        /// What the service said, for the Agent and the owner to read.
        message: string,
    }

    /// How a Run ended.
    variant run-end {
        /// It finished.
        completed,
        /// It used every Round it was allowed.
        budget-exhausted,
        /// The process stopped before it finished.
        interrupted,
        /// It was cancelled.
        cancelled,
        /// The owner went back in the conversation, which stopped it.
        backtracked,
        /// Execution stopped with this recorded failure.
        failed(failure),
        /// A halt of this Session or an ancestor stopped it.
        halted,
    }
}

/// Host-owned logging and transport available to plugins.
interface host {
    use types.{json};

    /// The configuration of this invocation's generation, excluding credential mappings.
    config: func() -> json;
    /// Severity attached to a plugin diagnostic.
    enum log-level { trace, debug, info, warn, error }

    /// Write a diagnostic to the host log.
    log: func(level: log-level, message: string);

    /// An HTTP request for the host to send.
    record http-request {
        /// The method, such as `GET` or `POST`.
        method: string,
        /// The absolute URL.
        url: string,
        /// Header names and values, in order.
        headers: list<tuple<string, string>>,
        /// The bytes to send, if any.
        body: option<list<u8>>,
        /// The time limit in milliseconds; the host's default when absent.
        timeout-ms: option<u32>,
    }

    /// An HTTP status, headers and fully collected response body.
    record http-response {
        /// The status code, such as 200.
        status: u16,
        /// Header names and values, in order.
        headers: list<tuple<string, string>>,
        /// The whole body, already collected.
        body: list<u8>,
    }

    /// Classifies failures while constructing, sending or reading an HTTP request.
    enum http-error-kind { invalid-request, connect, timeout, body, too-large, other }

    /// Transport failure.
    record http-failure {
        /// The stage that failed.
        kind: http-error-kind,
        /// What went wrong.
        message: string,
        /// Whether the request may have reached the peer.
        request-sent: bool,
    }

    /// Send a request and collect its response; non-2xx statuses are returned as responses.
    ///
    /// The host attaches declared credentials only to the bound origin (scheme, host and port),
    /// overriding the matching request header. Redirects are followed only within that origin.
    /// Cross-origin redirects are returned unchanged. Credential values in response headers,
    /// bodies and failures are replaced with [redacted:<environment variable name>].
    /// Encoded forms of a credential (such as base64) are not redacted.
    http: async func(request: http-request) -> result<http-response, http-failure>;
}

/// Model-facing tools whose definitions are fixed with their generation.
interface tools {
    use types.{json, tool-spec, outcome};

    /// Project tool definitions from configuration already accepted by `lifecycle.describe`.
    ///
    /// Definitions are fixed with the generation, so this runs without network access.
    %list: func(config: json) -> list<tool-spec>;

    /// Execute one tool.
    ///
    /// `input` already fits the tool's `input-schema`; validate only what the schema cannot
    /// express. Return an unknown outcome when an external effect may have occurred but is
    /// unconfirmed.
    call: async func(name: string, input: json) -> outcome;
}

/// Adapts canonical requests to a model service protocol.
interface completion {
    use types.{failure, message, overflow, tool-spec, settings, usage};

    /// The frozen messages, disclosed tools and output budget for one completion.
    ///
    /// User messages may include images; tool messages contain one result followed by any images.
    record request {
        /// The messages, in order.
        messages: list<message>,
        /// The tools the model may call.
        tools: list<tool-spec>,
        /// The most tokens the reply may use; the service's default when absent.
        max-output-tokens: option<u32>,
    }

    /// The service-reported reason that generation stopped.
    enum stop-reason { end-turn, tool-calls, max-tokens, other }

    /// A completed model attempt.
    ///
    /// Canonical parts are text, tool calls and extensions; generated images stay in extensions.
    record completion {
        /// The reply, with the `assistant` role.
        message: message,
        /// What the attempt cost in tokens.
        usage: usage,
        /// Why generation stopped.
        stop-reason: stop-reason,
    }

    /// Why `complete` returned no completion.
    variant complete-error {
        /// The request failed.
        failed(failure),
        /// The service turned the request away as too large; a smaller request may succeed.
        overflow(overflow),
    }

    /// Perform one non-streaming completion.
    ///
    /// # Errors
    /// `overflow` when the service turns the request away as larger than the model accepts, as
    /// an HTTP 413 always does. Otherwise `failed`, with the codes `provider.network`,
    /// `provider.auth`, `provider.rate_limited`, `provider.server`, `provider.bad_request`,
    /// `provider.bad_response`, and `timeout`.
    complete: async func(settings: settings, request: request) -> result<completion, complete-error>;
}

/// Embeds texts for retrieval independently of model completion.
interface embedding {
    use types.{failure, settings};

    /// Return exactly one nonempty vector of finite numbers per input, in input order.
    /// All returned vectors must have the same width.
    ///
    /// # Errors
    /// Uses `provider.*` failure codes and `timeout`, as in `completion.complete`.
    embed: async func(settings: settings, inputs: list<string>) -> result<list<list<f32>>, failure>;
}

/// Answers independent questions against shared evidence, without generating messages.
interface decision {
    use types.{failure, settings};

    /// An option or score level.
    record label {
        /// The answer's name, unique within its question.
        name: string,
        /// What the option means, when the name alone is not clear.
        description: option<string>,
    }

    /// A yes/no predicate, an unordered choice, or score levels ordered from low to high.
    variant question-kind {
        /// A yes-or-no question.
        predicate,
        /// One option from an unordered list.
        choice(list<label>),
        /// A level on a scale, from low to high.
        score(list<label>),
    }

    /// Instructions and the allowed answer shape for one independent judgment.
    record question {
        /// What to judge, for the service to read.
        instructions: string,
        /// The shape the answer takes.
        kind: question-kind,
    }

    /// An answer to one question, as probabilities, or a refusal.
    ///
    /// Probabilities are finite and in [0, 1]; choice and score distributions sum to one
    /// within 0.01, allowing for rounding by the service.
    variant answer {
        /// The probability of yes.
        predicate(f64),
        /// One probability per option, in label order.
        choice(list<f64>),
        /// One probability per level, in label order.
        score(list<f64>),
        /// The service declined to answer this question.
        refused,
    }

    /// Evaluate each question against the same text state. Return one matching answer
    /// per question in input order; any question may instead receive `refused`.
    ///
    /// # Errors
    /// Uses `provider.*` failure codes and `timeout`, as in `completion.complete`.
    decide: async func(settings: settings, state: string, questions: list<question>) -> result<list<answer>, failure>;
}

/// Describes and checks the component without assigning its registry identity.
interface lifecycle {
    use types.{json, failure};

    /// A secret the host writes into the plugin's requests or frames; the plugin never sees it.
    record credential {
        /// The name the owner maps to an environment variable.
        name: string,
        /// Whether registration fails without a secret mapping for it.
        required: bool,
        /// Every place the host writes the value, each bound to its origin; at least one.
        placements: list<placement>,
    }

    /// One place a credential goes, and the only origin that receives it there.
    record placement {
        /// The destination origin; `*.` covers subdomains. Absent means the service the caller
        /// selects, such as a channel's base URL, by HTTP or WebSocket.
        origin: option<string>,
        /// Where in a request or frame to that origin.
        location: location,
    }

    /// Where the host writes a credential; a socket's opening handshake is a request like any
    /// other.
    variant location {
        /// A request header set to its prefix followed by the value.
        header(header-placement),
        /// Right after whichever of these prefixes the request path starts with.
        path(list<string>),
        /// In each text frame sent on a socket, at this JSON pointer, where the frame holds `null`.
        frame(string),
    }

    /// A request header that carries a credential.
    record header-placement {
        /// The header's name.
        name: string,
        /// Text placed before the value, such as `Bearer `.
        prefix: string,
    }

    /// Plugin-wide facts and requirements.
    record description {
        /// One line on what the plugin offers.
        summary: string,
        /// The configuration the plugin accepts, as JSON Schema; only `describe` validates it.
        config-schema: json,
        /// The credentials the plugin uses.
        credentials: list<credential>,
    }

    /// Describe the component or reject its configuration.
    ///
    /// An empty object must be accepted and provide the plugin's minimum capabilities.
    /// Declarations are fixed with the generation, so this runs without network access.
    describe: func(config: json) -> result<description, failure>;

    /// Check the component without network access or owner-specific configuration.
    probe: async func() -> result<_, failure>;
}

/// Imports and lifecycle operations shared by all plugins.
world base {
    import host;
    export lifecycle;
}

/// A plugin exposing completion and embedding operations.
world provider-plugin {
    include base;
    export completion;
    export embedding;
}

/// A plugin exposing model completion.
world completion-plugin {
    include base;
    export completion;
}

/// A plugin exposing text embedding.
world embedding-plugin {
    include base;
    export embedding;
}

/// A plugin exposing typed decisions over shared evidence.
world decision-plugin {
    include base;
    export decision;
}

/// A plugin exposing model-facing tools.
world tool-plugin {
    include base;
    export tools;
}

/// Writes the model requests of the Sessions whose profile names this plugin.
///
/// A composition is a pure function of its arguments, the plugin's configuration and its own code,
/// and changes nothing but its result: it has no files, no environment variables and no network, so
/// `host.http` fails. The wall clock reads the Round's instant, the monotonic clock stands still and
/// randomness is seeded by the Round, so the same generation, called again within a Round with the
/// same arguments, returns the same plan.
///
/// The host records each plan before sending it and resolves its Log references. A plan breaks
/// this contract when it discloses a capability outside this Round, refers to a position outside
/// the transcript, or sends images to a model that does not accept them; when a reply plan leaves
/// out a capability in `lifeline`; or when a compaction discloses any tool, stops where no Round
/// ends, or leaves no transcript item after it for the reply to answer.
interface composer {
    use types.{datetime, failure, image-format, json, overflow, quote-kind, role, run-end, tool-spec, unviewable, usage};

    /// The position of an entry in this Session's Log.
    record log-pos {
        /// The ownership epoch that wrote the entry; 1 on a single node.
        epoch: u64,
        /// The entry's place within its epoch.
        seq: u64,
    }

    /// A directory on a node.
    ///
    /// Nothing guarantees that it exists; a tool that needs it checks when it uses it.
    record working-dir {
        /// The node whose file system holds it.
        node: string,
        /// Its absolute path on that node.
        path: string,
    }

    /// Another Session, by identity and full name.
    record session-source {
        /// Its permanent ID.
        id: string,
        /// Its full name.
        name: string,
    }

    /// The Session the request is for.
    record session {
        /// Its permanent ID.
        id: string,
        /// Its unique name, as the owner's commands use it.
        name: string,
        /// The profile it uses, by name.
        profile: string,
        /// When it was created.
        created-at: datetime,
        /// Where its file tools resolve relative paths and its shell commands run by default, as
        /// pinned for this Round.
        working-dir: working-dir,
        /// The Session that delegated to this one; absent for a Session the owner created. Inputs
        /// whose `event-source` is `parent` came from it.
        parent: option<session-source>,
    }

    /// A recorded file, by reference rather than by its bytes.
    record file-ref {
        /// What it is called: its filename, or what it is when it came without one.
        name: string,
        /// The size of the bytes.
        size: u64,
        /// The BLAKE3 digest of the bytes, in lowercase hex.
        content: string,
        /// The file that holds the bytes.
        path: string,
    }

    /// What another Session addressed to this one: a task from the parent, or a child's reply
    /// or message.
    record session-message {
        /// What it wrote; the canonical message carries only this.
        text: string,
        /// A file it sent.
        file: option<file-ref>,
    }

    /// A stop of a whole subtree.
    record halt {
        /// The Session at the top of the halted subtree, by full name.
        root: string,
        /// The Session that halted it, by full name; absent when the owner did.
        by: option<string>,
    }

    /// A recorded image, by reference rather than by its bytes.
    record image-ref {
        /// How the bytes are encoded.
        format: image-format,
        /// The size of the bytes.
        size: u64,
        /// The BLAKE3 digest of the bytes, in lowercase hex.
        content: string,
        /// The file that holds the bytes.
        path: string,
    }

    /// An attachment as recorded: an image a model may view, or any other file.
    variant attachment-ref {
        /// Bytes in an accepted image format, within the image limit.
        image(image-ref),
        /// Any other file.
        file(file-ref),
    }

    /// Messages quoted by an input, with their stored attachments.
    record quote {
        /// Whether the input replies to these messages or forwards them.
        kind: quote-kind,
        /// The content or its recorded unavailability.
        messages: quoted,
    }

    /// What the input records about quoted content.
    variant quoted {
        /// The messages, in their recorded order.
        messages(list<quoted-message>),
        /// Why the messages could not be obtained.
        unavailable(string),
    }

    /// A message inside an input's reply or forward.
    record quoted-message {
        /// Nesting depth; a nested forward follows the message that forwards it, one level deeper.
        depth: u8,
        /// The sender's protocol ID, when reported.
        sender: option<string>,
        /// The sender's display name, when reported.
        sender-name: option<string>,
        /// Whether the sender was the owner when the input arrived.
        owner: bool,
        /// Whether this account sent the quoted message.
        yours: bool,
        /// The named original conversation, when it was elsewhere.
        conversation-name: option<string>,
        /// When the message was first sent, when reported.
        sent-at: option<datetime>,
        /// What the sender wrote.
        text: string,
        /// The quoted attachments in their recorded order.
        attachments: list<attachment-ref>,
        /// Content that could not be shown, and why.
        unviewable: list<unviewable>,
    }

    /// Messages quoted by group context, with attachment descriptions only.
    record earlier-quote {
        /// Whether the earlier message replies to these messages or forwards them.
        kind: quote-kind,
        /// The content carried by the protocol, or why it is not shown; absent when it needed a
        /// request, which earlier context does not make.
        messages: option<earlier-quoted>,
    }

    /// What an earlier message carries about quoted content.
    variant earlier-quoted {
        /// The messages carried by the protocol.
        messages(list<earlier-quoted-message>),
        /// Why the protocol could not supply them.
        unavailable(string),
    }

    /// A quoted message in earlier context; attachments remain descriptions.
    record earlier-quoted-message {
        /// Nesting depth; a nested forward follows its parent one level deeper.
        depth: u8,
        /// The sender's protocol ID, when reported.
        sender: option<string>,
        /// The sender's display name, when reported.
        sender-name: option<string>,
        /// Whether the sender was the owner when the earlier message arrived.
        owner: bool,
        /// Whether this account sent the quoted message.
        yours: bool,
        /// The named original conversation, when it was elsewhere.
        conversation-name: option<string>,
        /// When the message was first sent, when reported.
        sent-at: option<datetime>,
        /// What the sender wrote.
        text: string,
        /// Descriptions of attachments; their bytes were not fetched.
        attachments: list<string>,
        /// Content that could not be shown, and why.
        unviewable: list<unviewable>,
    }

    /// A tool call that a reply proposed.
    record call {
        /// Enco's ID for the call, which its result repeats.
        id: string,
        /// The tool called.
        name: string,
        /// The arguments as the model wrote them, as JSON text.
        arguments: string,
    }

    /// What the model read as the result of a call.
    record call-result {
        /// Matches the proposed call so its result can remain adjacent in the request.
        call-id: string,
        /// The result text.
        content: string,
        /// Whether the call failed.
        is-error: bool,
    }

    /// One piece of a recorded message.
    variant part {
        /// Words recorded from a speaker or returned by a tool.
        text(string),
        /// A proposed tool call.
        tool-call(call),
        /// The result of a call.
        tool-result(call-result),
        /// The size in bytes of adapter fields, which the host gives only to the plugin that wrote
        /// them; they hold the whole message as that plugin replays it.
        extension(u64),
        /// A recorded picture the plan may include when the target accepts images.
        image(image-ref),
    }

    /// A message as the Log records it.
    record message {
        /// Who speaks.
        role: role,
        /// The content, in order.
        parts: list<part>,
    }

    /// The channel conversation an input came from.
    record channel-source {
        /// The protocol, as the channel mapper names it, such as `telegram`.
        protocol: string,
        /// The account within the protocol.
        account: string,
        /// The conversation that replies return to.
        conversation: string,
        /// The authenticated sender.
        sender: string,
        /// The sender's display name, when the protocol reported one.
        sender-name: option<string>,
        /// Whether the sender was the owner when the message was accepted.
        owner: bool,
    }

    /// Who produced an input.
    variant event-source {
        /// The owner, through Enco's own interface.
        cli,
        /// Someone in a channel conversation.
        channel(channel-source),
        /// A schedule.
        scheduler,
        /// The plugin registry, after an automatic rollback.
        registry,
        /// The Session that delegated to this one, named in `session.parent`; a halt from further
        /// up the tree also arrives from here.
        parent,
        /// A Session this one delegated to.
        child(session-source),
    }

    /// A prior message quoted for context; it did not drive the Session.
    record earlier-message {
        /// When the host received this message.
        received-at: datetime,
        /// The sender's protocol ID, when reported.
        sender: option<string>,
        /// The sender's display name, when reported.
        sender-name: option<string>,
        /// Whether the sender was the owner when the message was accepted.
        owner: bool,
        /// What the sender wrote.
        text: string,
        /// Descriptions of attachments; their bytes are not fetched for context.
        attachments: list<string>,
        /// Messages this earlier message replied to or forwarded.
        quote: option<earlier-quote>,
    }

    /// A message that drove the Session.
    record user-message {
        /// What the sender wrote.
        text: string,
        /// Its attachments, in the order they were sent.
        attachments: list<attachment-ref>,
        /// Content kept only as a description, and why.
        unviewable: list<unviewable>,
        /// Earlier messages quoted for context; the canonical message excludes them.
        earlier: list<earlier-message>,
        /// Messages this input replies to or forwards.
        quote: option<quote>,
    }

    /// A schedule reaching its time.
    record reminder {
        /// The schedule's ID.
        schedule: string,
        /// When this occurrence was due.
        due-at: datetime,
        /// Earlier occurrences that were missed and not delivered.
        skipped: u32,
        /// The instruction recorded when this occurrence became due.
        text: string,
    }

    /// A trial generation that failed, and what runs instead.
    record rollback {
        /// The plugin, by name.
        plugin: string,
        /// The failed trial generation.
        trial: u64,
        /// The generation running now; absent when none is healthy.
        replacement: option<u64>,
        /// The fault that caused the rollback.
        failure: failure,
        /// The notice the registry wrote.
        text: string,
    }

    /// What an input says.
    variant event-body {
        /// A message that drove the Session.
        user-message(user-message),
        /// A scheduled reminder.
        reminder(reminder),
        /// A notice of an automatic rollback.
        generation-rolled-back(rollback),
        /// The owner went back in the conversation: to the message at this Log position, or to
        /// its start when absent; the transcript continues from there.
        ///
        /// When that message is an input, the backtrack asks for a reply to it. Changes made after
        /// it outside the conversation, such as to files, were not undone.
        backtrack(option<log-pos>),
        /// Words from another Session.
        session-message(session-message),
        /// A child's Run that ended without completing, and how.
        child-run-ended(run-end),
        /// This Session's work and that of its children were stopped; the inputs between the end
        /// of its last Run and this halt were not answered.
        ///
        /// Unlike a backtrack, it leaves the conversation as it is, and it is not interactive:
        /// replies keep going where they went.
        halt(halt),
    }

    /// An input this Session consumed.
    record event {
        /// The globally unique identity assigned when the input was accepted.
        id: string,
        /// When it arrived.
        received-at: datetime,
        /// Who produced it.
        source: event-source,
        /// What it says.
        body: event-body,
        /// Whether its sender waits for a reply.
        ///
        /// The kernel decides it from the source and the kind, the same way it decides where
        /// replies go; while such an input awaits an answer, `reply_skip` fails.
        interactive: bool,
    }

    /// A Run's end, and where the Log records it.
    record run-ended {
        /// The entry that records the end.
        pos: log-pos,
        /// How the Run ended.
        end: run-end,
    }

    /// A message the Log records, with the input it came from.
    record transcript-item {
        /// Where the Log records it.
        pos: log-pos,
        /// Canonical content a plan can repeat through this Log position.
        message: message,
        /// The input it records; absent for replies and tool results.
        event: option<event>,
    }

    /// The history a plan may refer to.
    record transcript {
        /// The latest summary, which replaces the history before it.
        summary: option<string>,
        /// The messages after that summary, in Log order.
        items: list<transcript-item>,
        /// The ends of complete Rounds, where a compaction may stop, in Log order.
        round-ends: list<log-pos>,
        /// How each Run after the summary ended, in Log order.
        run-ends: list<run-ended>,
    }

    /// A durable fact about the owner, as the memory records hold it.
    record memory {
        /// Its identity, kept through corrections; the memory tools take it.
        id: string,
        /// The current statement.
        text: string,
        /// Whether it is offered every Round regardless of the input.
        pinned: bool,
        /// When it was created.
        created-at: datetime,
        /// When it was last changed.
        updated-at: datetime,
        /// Starts at one and grows with each correction.
        rev: u64,
    }

    /// Content left out of a request, and why.
    record omission {
        /// What was left out, such as `memory:<id>`.
        source: string,
        /// Why, for whoever inspects the request.
        reason: string,
    }

    /// A tool's identity, qualified by the node that provides it.
    record capability-id {
        /// The node that provides the tool.
        node: string,
        /// The tool's name, unique within a Round.
        name: string,
    }

    /// A tool this Round may disclose.
    record capability {
        /// The identity a plan discloses it by.
        id: capability-id,
        /// The definition the host records with a plan that discloses it.
        spec: tool-spec,
    }

    /// A plugin left out of this Round.
    record unavailable-plugin {
        /// The plugin, by name.
        plugin: string,
        /// Why it is left out.
        failure: failure,
    }

    /// Why this Round runs in safe mode.
    variant safe-mode {
        /// The owner turned safe mode on.
        owner,
        /// This Run failed against the generations that are still running.
        failed(failure),
    }

    /// A model's limits.
    record budget {
        /// The context window, output included.
        context-tokens: u32,
        /// The most tokens a reply may use.
        max-output-tokens: u32,
    }

    /// Input other than text that a model accepts.
    enum modality {
        /// Images.
        image,
    }

    /// A reply endpoint passed over, and why.
    record skipped-endpoint {
        /// The endpoint, by its configured name.
        endpoint: string,
        /// Why it was passed over.
        failure: failure,
    }

    /// A plan its target turned away as too large.
    record overflowed {
        /// The plan, as the host recorded it.
        plan: plan,
        /// What the service said about it.
        overflow: overflow,
    }

    /// The model a reply plan is for.
    record reply-target {
        /// Its limits.
        budget: budget,
        /// What it accepts besides text.
        accepts: list<modality>,
        /// Earlier candidates that are unavailable or exhausted in this Run, in configured order.
        skipped: list<skipped-endpoint>,
        /// What the service reported for the request made from `previous`, when this target's
        /// endpoint settings and Provider generation served it.
        ///
        /// Absent otherwise, since another model counts tokens differently.
        previous-usage: option<usage>,
        /// The latest plan the endpoint settings and Provider generation behind this target turned
        /// away as too large in this Round, a reply or a summary.
        ///
        /// Only a plan whose Log items the transcript still holds counts, so after a compaction it
        /// is an earlier refusal, often a summary's, or absent.
        overflowed: option<overflowed>,
    }

    /// The model that summarizes history.
    record compaction-target {
        /// Its limits.
        budget: budget,
        /// As on `reply-target`, for the endpoint settings and Provider generation behind this
        /// target.
        overflowed: option<overflowed>,
    }

    /// A child of this Session, by the facts that change only at moments its parent sees.
    ///
    /// Whether it is running right now is not here; `self_status` shows it.
    record child {
        /// Its name relative to this Session, as `session_send` takes it.
        name: string,
        /// The profile it uses.
        profile: string,
        /// Whether this Session awaits its answer: the latest of its inputs still awaiting an
        /// answer came from this Session.
        ///
        /// An answer is a reply that ends one of its Rounds, or the outcome of a Run that ended
        /// without completing; a halt ends the wait without one. While its replies go to this
        /// Session, each answer arrives here as input.
        awaiting: bool,
        /// The halt that stopped it, when it has received no input since.
        halted: option<halt>,
        /// Whether the owner spoke to it after this Session did, so its replies go to the owner.
        replies-to-owner: bool,
    }

    /// A reply model of a profile.
    record profile-endpoint {
        /// The endpoint, by its configured name.
        endpoint: string,
        /// The model it calls.
        model: string,
        /// What it accepts besides text.
        accepts: list<modality>,
        /// Its limits.
        budget: budget,
    }

    /// A profile a new child may use.
    record delegable-profile {
        /// The profile, as `session_send` takes it.
        name: string,
        /// What the owner wrote it is for.
        description: string,
        /// Its reply models, in configured order.
        reply: list<profile-endpoint>,
    }

    /// Everything the host supplies for one composition.
    record compose-input {
        /// The Session the request is for.
        session: session,
        /// The owner's time zone, as an IANA name such as `Asia/Shanghai`.
        timezone: string,
        /// The home's absolute path on the node running this Round.
        ///
        /// Its layout is part of this contract: `config.toml`; the standing instructions,
        /// `AGENTS.md` for the owner and `profiles/<name>.md` for each profile; `plugins/<name>/`,
        /// `sdk/`, `manual/`, and `workspace/`, the working directory of a new Session. `.data/` is
        /// Enco's own store and not part of it.
        home: string,
        /// The conversation as it stands, which a plan may refer to.
        ///
        /// After a backtrack it is the Log up to the backtrack's target, then everything from the
        /// backtrack on, so positions can skip.
        transcript: transcript,
        /// The plan of the latest completed reply request in that conversation; absent at the
        /// start, or when it could not be read, which `omitted` then says.
        previous: option<plan>,
        /// Whether the owner asked for the conversation to be compacted before this Round's reply.
        ///
        /// Once this Round records a compaction, it is false for the Round's later compositions.
        compaction-requested: bool,
        /// Whether this Session has the owner's context: its profile and every ancestor's give it.
        owner-context: bool,
        /// The owner instructions: the text of `AGENTS.md`, as read at the start of this Round.
        ///
        /// Absent when the file does not exist, when `owner-context` is false, and in safe mode.
        owner-instructions: option<string>,
        /// The profile instructions: the text of `profiles/<profile>.md` for this Session's
        /// profile, as read at the start of this Round.
        ///
        /// Absent when the file does not exist, and in safe mode. Unlike `owner-instructions`, it
        /// does not depend on the owner's context.
        profile-instructions: option<string>,
        /// Memories for this Round in priority order: pinned ones first, then those recalled for
        /// the latest input, most relevant first.
        ///
        /// Empty when `owner-context` is false, and in safe mode.
        memories: list<memory>,
        /// Content the host could not supply; the host records it with the plan.
        omitted: list<omission>,
        /// Every tool this Round may disclose; in safe mode, only the lifeline.
        capabilities: list<capability>,
        /// The tools every reply plan must disclose; empty when the Session does not require the
        /// lifeline.
        lifeline: list<capability-id>,
        /// Plugins left out of this Round.
        unavailable: list<unavailable-plugin>,
        /// Why this Round runs in safe mode; absent in normal operation.
        safe-mode: option<safe-mode>,
        /// The model a reply plan is for.
        reply: reply-target,
        /// The summarizing model; absent when no summarizing model is usable.
        compaction: option<compaction-target>,
        /// This Session's children that are not archived, in creation order.
        children: list<child>,
        /// The profiles a new child may use; empty when this Session cannot delegate.
        profiles: list<delegable-profile>,
    }

    /// A source a plan renders, with a digest a later composition can compare.
    record source {
        /// The source, such as `memory:<id>`.
        id: string,
        /// The BLAKE3 digest of its text before formatting, in lowercase hex.
        hash: string,
    }

    /// Text the composer wrote, recorded verbatim.
    record inline {
        /// Who speaks.
        role: role,
        /// The exact words the host will record and send to the model.
        text: string,
        /// The sources it renders, in order.
        sources: list<source>,
    }

    /// A Log message the request repeats.
    record log-ref {
        /// The message, by its position in the transcript.
        pos: log-pos,
        /// Whether its images go with it; all of them or none.
        images: bool,
    }

    /// One message of a request.
    variant plan-item {
        /// Text the composer wrote.
        message(inline),
        /// A message from the Log.
        log(log-ref),
    }

    /// A request, before the host records and resolves it.
    record plan {
        /// The messages, in order.
        items: list<plan-item>,
        /// The tools to disclose, by identity.
        tools: list<capability-id>,
        /// The most tokens the reply may use; the service's default when absent.
        max-output-tokens: option<u32>,
        /// What the composer left out, and why.
        omitted: list<omission>,
    }

    /// A request to summarize history before replying.
    record compaction {
        /// The last Round end to summarize: one of `transcript.round-ends`, before the latest
        /// transcript item, so the reply after the summary has history to answer.
        upto: log-pos,
        /// The summarizing request; it discloses no tools.
        plan: plan,
    }

    /// What a composition returns.
    variant composition {
        /// A reply request.
        reply(plan),
        /// Summarize history first; the host composes again once the summary is recorded.
        compact(compaction),
    }

    /// The JSON Schema of the options a profile passes to `compose`, in the subset `tool-spec`
    /// states.
    ///
    /// An empty object must fit it. The host checks a profile's options against the schema of the
    /// generation that runs them: registering configuration or code that breaks a profile's options
    /// is rejected, and a profile whose options no longer fit, as after a rollback, cannot use this
    /// plugin until they do. The schema is fixed with the generation, so this runs without network
    /// access.
    options-schema: func(config: json) -> json;

    /// Write the next request.
    ///
    /// `options` fit the running generation's `options-schema` and are normalized as tool arguments
    /// are. Return `compact` only while `compaction` is present. Each compaction ends at a Round
    /// end the transcript shows and hides it, so a Round's compactions end with its visible
    /// history. When the target a composition is for carries `overflowed`, return a composition
    /// other than that plan: the service behind the target turned it away, and returning it again
    /// breaks the contract.
    ///
    /// # Errors
    /// `context.overflow` when no valid request fits the window; when only a compaction would make
    /// it fit and `compaction` is absent, the host records why no summarizing model is usable. The
    /// host records any other code as `compose.failed`.
    compose: func(options: json, input: compose-input) -> result<composition, failure>;
}

/// A plugin that writes model requests.
world composer-plugin {
    include base;
    export composer;
}

/// Translates a messaging protocol as a pure state machine; the host owns connections, timers and credentials.
///
/// The host records each external input before handing it over, and carries out what the mapper asks.
interface channel {
    use types.{datetime, failure, json, quote-kind, run-end, unviewable};

    /// A request for the host to send.
    record request {
        /// The method, such as `GET` or `POST`.
        method: string,
        /// A path starting with `/`, joined to the connection's base URL, or an absolute URL at
        /// one of the mapper's `origins`.
        url: string,
        /// Header names and values, in order.
        headers: list<tuple<string, string>>,
        /// The bytes to send, if any.
        body: option<list<u8>>,
        /// The time limit in milliseconds; the host's default when absent.
        timeout-ms: option<u32>,
    }

    /// A response the protocol returned, whatever its status.
    record response {
        /// The status code, such as 200.
        status: u16,
        /// Header names and values, in order.
        headers: list<tuple<string, string>>,
        /// The whole body.
        body: list<u8>,
    }

    /// A WebSocket the host opens and keeps until the mapper asks to reconnect or the connection
    /// stops.
    record socket {
        /// Where to open the socket: a path on the base URL, or an absolute `ws` or `wss` URL.
        ///
        /// A path starts with `/` and joins the base URL with `http` turned into `ws` and `https`
        /// into `wss`. An absolute URL must be on the base URL's host and port, or at one of the
        /// mapper's `origins`.
        url: string,
        /// The code the host closes the socket with; a protocol that resumes sessions across
        /// reconnects may need one other than 1000.
        close-code: u16,
    }

    /// The time the host leaves before each message it sends through one connection.
    ///
    /// Each field is at most the limit the manual lists for channel `pacing`; a larger gap fails
    /// loading, because stopping a connection waits out a started gap.
    record pacing-gap {
        /// The least milliseconds from one message finishing to the next one starting.
        minimum-ms: u32,
        /// Up to this many more milliseconds before each message, chosen at random.
        jitter-ms: u32,
    }

    /// How the host reads the protocol next.
    variant read-step {
        /// Send this request; its response is one arrival.
        request(request),
        /// Open this socket; each frame on it is one arrival, until it closes.
        socket(socket),
    }

    /// Something that reached the mapper through the host.
    variant arrival {
        /// The response to the read request.
        response(response),
        /// A text frame on the open socket.
        frame(string),
        /// The socket closed, by the protocol or through a network failure.
        closed(closure),
        /// The timer the mapper set has expired; its reading can change state and request actions, but has no inbound messages.
        timer,
    }

    /// How a socket ended.
    record closure {
        /// The close code, when the protocol sent one.
        code: option<u16>,
        /// The close reason, or the host's description of the network failure.
        reason: string,
    }

    /// What the mapper asks of the host after one arrival.
    record reading {
        /// Messages to accept, in order.
        messages: list<inbound>,
        /// The protocol state after this arrival; absent leaves it unchanged.
        ///
        /// The host uses it for the next call at once, and commits it once every message of this reading is accepted.
        state: option<json>,
        /// Text frames to send on the socket now, in order.
        frames: list<string>,
        /// Protocol acknowledgments to send before acceptance, with no effect beyond confirming receipt.
        ///
        /// Answers to this reading's messages are sent only after these complete.
        acknowledgments: list<request>,
        /// Milliseconds until a `timer` arrival, replacing any pending timer; absent keeps it.
        /// Timers end with the socket.
        timer: option<u32>,
        /// Close the socket and start the next read with `read`.
        reconnect: bool,
    }

    /// What a protocol answer means for the host's settlement and retries.
    record fault {
        /// What failed.
        failure: failure,
        /// The request may have taken effect, so it must not be sent again.
        unknown: bool,
        /// The whole connection is unusable, not just this request or destination.
        fatal: bool,
        /// How long the protocol asks to wait before retrying, in seconds.
        retry-after: option<u32>,
    }

    /// The account a connection reaches.
    record identity {
        /// A nonempty protocol name without colons; with `account`, it keys connection state.
        protocol: string,
        /// A nonempty, stable account ID within the protocol, treated as opaque by the host.
        account: string,
        /// What the mapper needs to know about the account later, such as the bot's username.
        facts: json,
    }

    /// A conversation's name, as far as the protocol carries it.
    variant conversation-name {
        /// The nonempty name, carried with the message.
        name(string),
        /// Fetch this nonempty locator to obtain it; the fetch ends with `fetch-step.name`.
        fetch(string),
    }

    /// A message that arrived, as the protocol describes it.
    record inbound {
        /// The protocol's key for accepting this message once, such as an update or event ID.
        key: string,
        /// The conversation, where replies go.
        conversation: string,
        /// The realm this conversation is in, such as a Discord server or a Telegram chat with
        /// topics; absent for a conversation on its own.
        ///
        /// A realm is what a protocol groups several conversations under; a direct chat or a group
        /// without topics is in none. Its ID is nonempty. The owner can declare a realm private to
        /// them; its conversations are then private.
        realm: option<string>,
        /// The conversation's name, such as a topic's title, when the protocol gives one; the host
        /// only uses it to name a Session made for the conversation.
        conversation-name: option<conversation-name>,
        /// This message's ID, unique within the conversation.
        message: string,
        /// The sender's ID, when the protocol reports one.
        sender: option<string>,
        /// The sender's display name, when the protocol reports one.
        sender-name: option<string>,
        /// Whether the conversation is one to one.
        direct: bool,
        /// Whether the message is addressed to this bot; always true in a direct conversation.
        addressed: bool,
        /// The message this one replies to, or the message a command was invoked on.
        reply-to: option<string>,
        /// The handle for answering this message once accepted, when the protocol expects an
        /// answer, such as for a command or a button.
        respond: option<string>,
        /// What it asks for.
        action: action,
    }

    /// What an incoming message asks for, whatever the protocol's command syntax.
    variant action {
        /// A message for the conversation's Session.
        message(content),
        /// List the Sessions to choose from.
        sessions,
        /// Route this conversation to the named Session.
        select-session(string),
        /// Stop the work the conversation's Session is doing.
        cancel,
        /// Take the conversation back to the message `reply-to` names.
        backtrack,
        /// Open this group to everyone or close it to the owner only; absent reports which.
        everyone(option<bool>),
        /// Halt the named Session and its descendants, or the conversation's Session when absent.
        halt(option<string>),
        /// Archive the named Session and its descendants, or list archivable Sessions when absent.
        archive(option<string>),
        /// Show the conversation's Session and its context.
        status,
        /// Compact the conversation's history when its Session's next Run starts.
        compact,
        /// Start the conversation over; its earlier messages stay recorded.
        clear,
    }

    /// The text and attachments of a message.
    record content {
        /// What the sender wrote as people in the chat see it; mentions use names where the
        /// protocol supplies them, and a leading mention of this bot is left out.
        text: string,
        /// Its attachments in order; the host fetches each and keeps it as an image or a file.
        attachments: list<attachment>,
        /// Parts of the content that cannot be shown, and why.
        unviewable: list<unviewable>,
        /// The messages it replies to or forwards, when it does.
        quote: option<quote>,
    }

    /// Messages shown inside another message.
    record quote {
        /// Whether the message replies to them or forwards them.
        kind: quote-kind,
        /// The messages, or how to get them.
        messages: quoted,
    }

    /// The quoted content, as far as the protocol carries it.
    variant quoted {
        /// Carried in the message itself: at least one, the first at depth 0, each nested at most
        /// one level below the one before.
        messages(list<quoted-message>),
        /// Fetch this locator to obtain the messages.
        fetch(string),
        /// Why the protocol cannot give the messages.
        unavailable(string),
    }

    /// A message shown inside another, as the protocol showed it.
    record quoted-message {
        /// Nesting depth, starting at zero; nested forwards follow their parent one level deeper.
        depth: u8,
        /// The sender's ID, when the protocol reports one.
        sender: option<string>,
        /// The sender's display name, when reported.
        sender-name: option<string>,
        /// The name of the original conversation, when it was elsewhere and the protocol names it.
        conversation-name: option<string>,
        /// When it was first sent, when reported.
        sent-at: option<datetime>,
        /// What the sender wrote as people in the chat see it, mentions of this bot included.
        text: string,
        /// Its attachments, by their protocol locators.
        attachments: list<attachment>,
        /// Content that could not be shown, and why.
        unviewable: list<unviewable>,
    }

    /// An attachment, by the protocol's locator for fetching its bytes.
    record attachment {
        /// What it is called: the filename the protocol shows people, or what it is, such as
        /// `voice message`, when there is none.
        ///
        /// It carries no extension the protocol does not give, and describes the attachment when
        /// it cannot be fetched.
        name: string,
        /// The opaque locator passed to `fetch`.
        locator: string,
    }

    /// File bytes for one outgoing message.
    record file-data {
        /// The filename without its original directory.
        name: string,
        /// The original bytes, encoded by the mapper for transport.
        data: list<u8>,
    }

    /// Markdown text with at most one file to send.
    record outgoing {
        /// All text to send, in Markdown.
        text: string,
        /// A file to send with this text, if any.
        file: option<file-data>,
    }

    /// A command the host understands, as it should appear in the protocol's menus.
    record command {
        /// Which command.
        kind: command-kind,
        /// What it does, for the menu.
        description: string,
        /// Whether it applies in private conversations: one-to-one ones, and those in a realm the
        /// owner declared private.
        direct: bool,
        /// Whether it applies in group conversations that are not private.
        group: bool,
    }

    /// The commands the host understands.
    enum command-kind {
        /// List the Sessions, or switch to the one named after it.
        session,
        /// Stop the work of the conversation's Session.
        cancel,
        /// Go back to the message the command replies to.
        backtrack,
        /// Open the group to everyone, or close it to the owner only.
        everyone,
        /// Halt the named Session and its descendants, or the conversation's Session when no name
        /// follows.
        halt,
        /// Archive the named Session and its descendants; with no name, list the Sessions that
        /// can be archived and archive nothing.
        archive,
        /// Show the conversation's Session and its context.
        status,
        /// Compact the conversation's history when its Session's next Run starts.
        compact,
        /// Start the conversation over; its earlier messages stay recorded.
        clear,
    }

    /// The next step of fetching the content a locator names.
    variant fetch-step {
        /// Send this request and call again with its response.
        request(request),
        /// Get this absolute URL taken from the protocol's content and call again with its
        /// response.
        ///
        /// The host sends it without credentials and only to one of the mapper's `origins`, so
        /// content never chooses a path on the service; an address elsewhere makes the attachment
        /// unavailable.
        download(string),
        /// The bytes of the file an attachment's locator names.
        file(list<u8>),
        /// The messages a quote's locator names, listed as `quoted.messages` is.
        messages(list<quoted-message>),
        /// The nonempty name a `conversation-name` locator names.
        name(string),
        /// The protocol refused it for good; the text says why.
        unavailable(string),
    }

    /// How a Run turned out, left in place of its view where the view was only for display.
    record activity-epilogue {
        /// Seconds the Run took.
        elapsed-seconds: u32,
        /// The Rounds it used.
        rounds: u32,
        /// How it ended.
        end: run-end,
        /// Whether it finished without sending its last reply.
        unsent: bool,
        /// The first line of its last reply, sent or not, shortened by the host; empty when it has
        /// none.
        excerpt: string,
    }

    /// What to do with a Run's view.
    variant activity-update {
        /// Show or refresh the live view.
        view(activity-view),
        /// End the view with the Run's epilogue: rewrite the view, or create one when none is
        /// shown.
        epilogue(activity-epilogue),
        /// Remove the view.
        remove,
    }

    /// What the Agent is doing while a Run goes on.
    record activity-view {
        /// Seconds since the Run started.
        elapsed-seconds: u32,
        /// The Run's latest tool calls, oldest first.
        tools: list<tool-activity>,
    }

    /// One tool call shown in an activity view.
    record tool-activity {
        /// The tool's name, as the model calls it.
        name: string,
        /// Where the call stands.
        state: tool-state,
        /// The values of the call's required arguments in its schema's order, on one line the host
        /// shortens; empty when it has none.
        arguments: string,
    }

    /// Where a tool call stands.
    enum tool-state {
        /// The call has started and has no settlement yet.
        running,
        /// It succeeded.
        ok,
        /// The call finished with a known failure.
        failed,
        /// It may have taken effect, but its result is not known.
        unknown,
    }

    /// Additional origins for requests and sockets; `*.` before a host covers its subdomains. Read
    /// when the generation loads.
    origins: func() -> list<string>;
    /// The gap before each message `send` builds; absent sends each as soon as it is ready. Read
    /// when the generation loads.
    pacing: func() -> option<pacing-gap>;
    /// The request that reads which account the connection reaches.
    identify: func() -> request;
    /// The account in that request's response.
    identified: func(response: response) -> result<identity, fault>;
    /// How to read next, from the latest protocol state; `state` is absent before the protocol
    /// gave one.
    ///
    /// `channel.invalid_state` means the state cannot be resumed. The host clears only that
    /// state and retries from `none`, keeping routes and other committed business facts. If the
    /// mapper rejects `none` too, the host stops the connection.
    read: func(identity: identity, state: option<json>) -> result<read-step, fault>;
    /// What an arrival means, given the latest protocol state.
    received: func(
        identity: identity,
        state: option<json>,
        arrival: arrival,
    ) -> result<reading, fault>;
    /// The next step of fetching the content at `locator`, given the responses so far.
    ///
    /// One fetch may send at most `limit` requests and downloads in all; asking for more is a
    /// contract failure.
    fetch: func(locator: string, responses: list<response>, limit: u32) -> result<fetch-step, fault>;
    /// The protocol messages to send, in order; at least one, none empty. Together they carry all
    /// of the message's text and its file, laid out as the protocol needs.
    split: func(message: outgoing) -> list<outgoing>;
    /// The request that sends one part to a conversation.
    send: func(conversation: string, part: outgoing) -> result<request, fault>;
    /// What the protocol answered: the ID of the message a request created, if any, or why it
    /// failed.
    ///
    /// A failure with code `channel.conversation_gone` means the conversation no longer exists;
    /// the host forgets its route.
    answered: func(response: response) -> result<option<string>, fault>;
    /// The request that answers the accepted message carrying `handle`, showing `text` to its
    /// sender; absent when nothing more needs sending.
    respond: func(handle: string, text: option<string>) -> result<option<request>, fault>;
    /// Requests that offer the host's commands in the protocol's menus, sent when a connection
    /// starts.
    commands: func(identity: identity, commands: list<command>) -> list<request>;
    /// Creates, refreshes, rewrites or removes a Run's view; absent when nothing needs sending,
    /// and for a new view when the protocol shows none.
    ///
    /// `replies-here` says whether the Run's replies go to `conversation`; otherwise the view is
    /// only for display there. Where they go, create no view when `presence` already shows it.
    ///
    /// A view is not a message for the reader's attention: where the protocol allows, create it
    /// without a notification.
    ///
    /// The host reads each response with `answered`. When it creates a live view (`view` without
    /// `shown`), it keeps the message ID `answered` gives as `shown`, and without one the Run
    /// shows no view there; an epilogue ends the view, so its ID is not kept.
    activity: func(
        conversation: string,
        replies-here: bool,
        shown: option<string>,
        update: activity-update,
    ) -> option<request>;
    /// A passing sign in `conversation` that the Agent is working, such as typing or an expiring
    /// draft of `view`; absent when the protocol has none.
    ///
    /// The host sends it only where the Run's replies go, when the Run starts and at each refresh
    /// until it ends, keeps nothing of it, and reads its response with `answered`.
    presence: func(conversation: string, view: activity-view) -> option<request>;
    /// The request opening a child Session's own conversation beside `beside`, where its parent
    /// shows; absent when the mapper knows the protocol cannot open one there.
    ///
    /// Where the protocol refuses to open one there, `opened` gives that failure and the child is
    /// not shown on this connection. `session` is the child's full name, segment by segment; lay
    /// out the title so that it reads apart from the conversations people open. Opening may leave
    /// the protocol's one-time notice.
    open-conversation: func(beside: string, session: list<string>) -> option<request>;
    /// The nonempty ID of the conversation that an `open-conversation` request made beside
    /// `beside` created, or why it failed.
    opened: func(beside: string, response: response) -> result<string, fault>;
    /// The request that puts away a conversation opened for a child Session once that Session is
    /// archived; absent when nothing needs sending.
    ///
    /// For instance, this deletes a topic or archives a thread. The host reads its response with
    /// `answered`.
    close-conversation: func(conversation: string) -> option<request>;
}

/// A messaging protocol's mapper. It imports nothing; the host trusts it with the connection's
/// account.
world channel-plugin {
    export lifecycle;
    export channel;
}
