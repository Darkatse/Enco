{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A reminder fires on September 5, a week before the son's corrected birthday (September 12), and none on August 26, a week before the stale date.",
  "type": "array",
  "contains": {
    "type": "object",
    "required": [
      "rule"
    ],
    "properties": {
      "rule": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "at"
            ],
            "properties": {
              "at": {
                "type": "string",
                "pattern": "^\\d{4}-09-05T"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "cron"
            ],
            "properties": {
              "cron": {
                "type": "string",
                "pattern": "^\\S+ \\S+ 0?5 0?9 \\S+$"
              }
            }
          }
        ]
      }
    }
  },
  "not": {
    "contains": {
      "type": "object",
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "at"
              ],
              "properties": {
                "at": {
                  "type": "string",
                  "pattern": "^\\d{4}-08-26T"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "cron"
              ],
              "properties": {
                "cron": {
                  "type": "string",
                  "pattern": "^\\S+ \\S+ 0?26 0?8 \\S+$"
                }
              }
            }
          ]
        }
      }
    }
  }
}
