{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Exactly one schedule fires every day at 08:00 in the owner's time zone. Other schedules, such as one-off reminders, are ignored. Equivalent cron spellings and zone aliases are accepted.",
  "type": "array",
  "contains": { "$ref": "#/$defs/daily-at-eight" },
  "minContains": 1,
  "maxContains": 1,
  "$defs": {
    "daily-at-eight": {
      "type": "object",
      "required": ["rule", "timezone"],
      "properties": {
        "rule": {
          "type": "object",
          "required": ["cron"],
          "properties": {
            "cron": {
              "type": "string",
              "pattern": "^0{1,2} 0?8 (\\*|\\?|1-31|\\*/1) (\\*|1-12|\\*/1) (\\*|\\?|0-6|1-7|0-7|\\*/1|[Mm][Oo][Nn]-[Ss][Uu][Nn]|[Ss][Uu][Nn]-[Ss][Aa][Tt])$"
            }
          }
        },
        "timezone": { "enum": ["America/New_York", "US/Eastern", "EST5EDT"] }
      }
    }
  }
}
